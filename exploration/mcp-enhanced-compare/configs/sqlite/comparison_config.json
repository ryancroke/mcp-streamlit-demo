  "baseline": {
    "source": {
      "type": "github",
      "repo": "modelcontextprotocol/servers-archived",
      "branch": "main",
      "subdirectory": "src/sqlite",
      "install_dir": "temp/mcp_baseline_from_git"
    },
    "mcp_server": {
      "name": "sqlite_baseline",
      "type": "sqlite",
      "command": "uv",
